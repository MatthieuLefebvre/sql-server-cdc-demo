.alter-merge table silver_work_orders (PriorityCode:string)

.alter table silver_work_orders policy update @'[{"IsEnabled":true,"Source":"bronze_cdc_raw","Query":"bronze_cdc_raw | where tostring(payload.source.table) == \"WorkOrders\" | extend record=iif(isnull(payload.after), payload.before, payload.after) | project tenant_id, source_instance, operation=tostring(payload.op), is_deleted=tobool(payload.op == \"d\"), event_utc=unixtime_milliseconds_todatetime(tolong(payload.ts_ms)), processed_utc=EventProcessedUtcTime, change_lsn=tostring(payload.source.change_lsn), WorkOrderId=toint(record.WorkOrderId), ProjectId=toint(record.ProjectId), EquipmentId=toint(record.EquipmentId), Summary=tostring(record.Summary), WorkOrderStatus=tostring(record.WorkOrderStatus), ScheduledDate=datetime(1970-01-01) + tolong(record.ScheduledDate) * 1d, LastModifiedUtc=unixtime_milliseconds_todatetime(tolong(record.LastModifiedUtc)), PriorityCode=tostring(record.PriorityCode)","IsTransactional":false,"PropagateIngestionProperties":true}]'

.alter table schema_drift_quarantine policy update @'[{"IsEnabled":true,"Source":"bronze_cdc_raw","Query":"bronze_cdc_raw | extend source_table=tostring(payload.source.table), record=iif(isnull(payload.after), payload.before, payload.after) | extend unexpected_fields=iif(source_table == \"WorkOrders\", set_difference(bag_keys(record), dynamic([\"WorkOrderId\",\"ProjectId\",\"EquipmentId\",\"Summary\",\"WorkOrderStatus\",\"ScheduledDate\",\"LastModifiedUtc\",\"PriorityCode\"])), dynamic([])) | where isempty(tenant_id) or isempty(source_instance) or source_table !in (\"Projects\",\"Equipment\",\"WorkOrders\",\"JobCosts\",\"Invoices\",\"DemoHeartbeat\") or array_length(unexpected_fields) > 0 | project tenant_id, source_instance, source_table, operation=tostring(payload.op), event_utc=unixtime_milliseconds_todatetime(tolong(payload.ts_ms)), processed_utc=EventProcessedUtcTime, reason=case(isempty(tenant_id) or isempty(source_instance), \"missing_identity\", source_table !in (\"Projects\",\"Equipment\",\"WorkOrders\",\"JobCosts\",\"Invoices\",\"DemoHeartbeat\"), \"unknown_table\", \"unexpected_fields\"), unexpected_fields, payload","IsTransactional":false,"PropagateIngestionProperties":true}]'