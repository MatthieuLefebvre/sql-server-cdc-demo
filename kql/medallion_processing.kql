.alter table silver_heartbeat policy update ```
[
    {
        "IsEnabled": true,
        "Source": "bronze_cdc_raw",
        "Query": "bronze_cdc_raw\n| where tostring(payload.source.table) == \"DemoHeartbeat\"\n| extend record = iif(isnull(payload.after), payload.before, payload.after)\n| project\n    tenant_id,\n    source_instance,\n    operation = tostring(payload.op),\n    is_deleted = tobool(payload.op == \"d\"),\n    event_utc = unixtime_milliseconds_todatetime(tolong(payload.ts_ms)),\n    processed_utc = EventProcessedUtcTime,\n    change_lsn = tostring(payload.source.change_lsn),\n    HeartbeatId = toint(record.HeartbeatId),\n    SequenceNumber = tolong(record.SequenceNumber),\n    BusinessMarker = tostring(record.BusinessMarker),\n    EmittedUtc = unixtime_milliseconds_todatetime(tolong(record.EmittedUtc))",
