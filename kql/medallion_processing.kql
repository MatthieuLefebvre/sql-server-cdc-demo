.create-merge table bronze_cdc_raw (
    schema:dynamic,
    payload:dynamic,
    tenant_id:string,
    source_instance:string,
    EventProcessedUtcTime:datetime,
    PartitionId:long,
    EventEnqueuedUtcTime:datetime
)

.alter-merge table bronze_cdc_raw policy retention softdelete = 7d

.create-merge table silver_projects (
    tenant_id:string,
    source_instance:string,
    operation:string,
    is_deleted:bool,
    event_utc:datetime,
    processed_utc:datetime,
    change_lsn:string,
    ProjectId:int,
    ProjectCode:string,
    ProjectName:string,
    RegionCode:string,
    ProjectStatus:string,
    Budget:decimal,
    LastModifiedUtc:datetime
)

.create-merge table silver_equipment (
    tenant_id:string,
    source_instance:string,
    operation:string,
    is_deleted:bool,
    event_utc:datetime,
    processed_utc:datetime,
    change_lsn:string,
    EquipmentId:int,
    AssetTag:string,
    EquipmentName:string,
    MeterHours:real,
    EquipmentStatus:string,
    LastModifiedUtc:datetime
)

.create-merge table silver_work_orders (
    tenant_id:string,
    source_instance:string,
    operation:string,
    is_deleted:bool,
    event_utc:datetime,
    processed_utc:datetime,
    change_lsn:string,
    WorkOrderId:int,
    ProjectId:int,
    EquipmentId:int,
    Summary:string,
    WorkOrderStatus:string,
    ScheduledDate:datetime,
    LastModifiedUtc:datetime,
    PriorityCode:string
)

.create-merge table silver_job_costs (
    tenant_id:string,
    source_instance:string,
    operation:string,
    is_deleted:bool,
    event_utc:datetime,
    processed_utc:datetime,
    change_lsn:string,
    JobCostId:long,
    ProjectId:int,
    CostType:string,
    Amount:decimal,
    CostDescription:string,
    PostedUtc:datetime
)

.create-merge table silver_invoices (
    tenant_id:string,
    source_instance:string,
    operation:string,
    is_deleted:bool,
    event_utc:datetime,
    processed_utc:datetime,
    change_lsn:string,
    InvoiceId:long,
    ProjectId:int,
    InvoiceNumber:string,
    InvoiceAmount:decimal,
    InvoiceStatus:string,
    IssuedDate:datetime,
    LastModifiedUtc:datetime
)

.create-merge table silver_heartbeat (
    tenant_id:string,
    source_instance:string,
    operation:string,
    is_deleted:bool,
    event_utc:datetime,
    processed_utc:datetime,
    change_lsn:string,
    HeartbeatId:int,
    SequenceNumber:long,
    BusinessMarker:string,
    EmittedUtc:datetime
)

.create-merge table schema_drift_quarantine (
    tenant_id:string,
    source_instance:string,
    source_table:string,
    operation:string,
    event_utc:datetime,
    processed_utc:datetime,
    reason:string,
    unexpected_fields:dynamic,
    payload:dynamic
)

// Each silver policy follows the same three-stage pipeline:
// 1. Keep events for one source table.
// 2. Select the current row image (before for deletes, after otherwise).
// 3. Convert the dynamic CDC payload into the typed silver schema.

.alter table silver_projects policy update ```
[
    {
        "IsEnabled": true,
        "Source": "bronze_cdc_raw",
        "Query": "bronze_cdc_raw\n| where tostring(payload.source.table) == \"Projects\"\n| extend record = iif(isnull(payload.after), payload.before, payload.after)\n| project\n    tenant_id,\n    source_instance,\n    operation = tostring(payload.op),\n    is_deleted = tobool(payload.op == \"d\"),\n    event_utc = unixtime_milliseconds_todatetime(tolong(payload.ts_ms)),\n    processed_utc = EventProcessedUtcTime,\n    change_lsn = tostring(payload.source.change_lsn),\n    ProjectId = toint(record.ProjectId),\n    ProjectCode = tostring(record.ProjectCode),\n    ProjectName = tostring(record.ProjectName),\n    RegionCode = tostring(record.RegionCode),\n    ProjectStatus = tostring(record.ProjectStatus),\n    Budget = todecimal(record.Budget),\n    LastModifiedUtc = unixtime_milliseconds_todatetime(tolong(record.LastModifiedUtc))",
        "IsTransactional": false,
        "PropagateIngestionProperties": true
    }
]```

.alter table silver_equipment policy update ```
[
    {
        "IsEnabled": true,
        "Source": "bronze_cdc_raw",
        "Query": "bronze_cdc_raw\n| where tostring(payload.source.table) == \"Equipment\"\n| extend record = iif(isnull(payload.after), payload.before, payload.after)\n| project\n    tenant_id,\n    source_instance,\n    operation = tostring(payload.op),\n    is_deleted = tobool(payload.op == \"d\"),\n    event_utc = unixtime_milliseconds_todatetime(tolong(payload.ts_ms)),\n    processed_utc = EventProcessedUtcTime,\n    change_lsn = tostring(payload.source.change_lsn),\n    EquipmentId = toint(record.EquipmentId),\n    AssetTag = tostring(record.AssetTag),\n    EquipmentName = tostring(record.EquipmentName),\n    MeterHours = todouble(record.MeterHours),\n    EquipmentStatus = tostring(record.EquipmentStatus),\n    LastModifiedUtc = unixtime_milliseconds_todatetime(tolong(record.LastModifiedUtc))",
        "IsTransactional": false,
        "PropagateIngestionProperties": true
    }
]```

.alter table silver_work_orders policy update ```
[
    {
        "IsEnabled": true,
        "Source": "bronze_cdc_raw",
        "Query": "bronze_cdc_raw\n| where tostring(payload.source.table) == \"WorkOrders\"\n| extend record = iif(isnull(payload.after), payload.before, payload.after)\n| project\n    tenant_id,\n    source_instance,\n    operation = tostring(payload.op),\n    is_deleted = tobool(payload.op == \"d\"),\n    event_utc = unixtime_milliseconds_todatetime(tolong(payload.ts_ms)),\n    processed_utc = EventProcessedUtcTime,\n    change_lsn = tostring(payload.source.change_lsn),\n    WorkOrderId = toint(record.WorkOrderId),\n    ProjectId = toint(record.ProjectId),\n    EquipmentId = toint(record.EquipmentId),\n    Summary = tostring(record.Summary),\n    WorkOrderStatus = tostring(record.WorkOrderStatus),\n    ScheduledDate = datetime(1970-01-01) + tolong(record.ScheduledDate) * 1d,\n    LastModifiedUtc = unixtime_milliseconds_todatetime(tolong(record.LastModifiedUtc)),\n    PriorityCode = tostring(record.PriorityCode)",
        "IsTransactional": false,
        "PropagateIngestionProperties": true
    }
]```

