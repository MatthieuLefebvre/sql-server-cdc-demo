// Quarantine anything that cannot safely enter a typed silver contract:
// missing identity, an unknown source table, or unexpected WorkOrders fields.
.alter table schema_drift_quarantine policy update ```
[
    {
        "IsEnabled": true,
        "Source": "bronze_cdc_raw",
        "Query": "bronze_cdc_raw\n| extend\n    source_table = tostring(payload.source.table),\n    record = iif(isnull(payload.after), payload.before, payload.after)\n| extend unexpected_fields = iif(\n    source_table == \"WorkOrders\",\n    set_difference(\n        bag_keys(record),\n        dynamic([\"WorkOrderId\", \"ProjectId\", \"EquipmentId\", \"Summary\", \"WorkOrderStatus\", \"ScheduledDate\", \"LastModifiedUtc\", \"PriorityCode\"])\n    ),\n    dynamic([])\n)\n| where\n    isempty(tenant_id)\n    or isempty(source_instance)\n    or source_table !in (\"Projects\", \"Equipment\", \"WorkOrders\", \"JobCosts\", \"Invoices\", \"DemoHeartbeat\")\n    or array_length(unexpected_fields) > 0\n| project\n    tenant_id,\n    source_instance,\n    source_table,\n    operation = tostring(payload.op),\n    event_utc = unixtime_milliseconds_todatetime(tolong(payload.ts_ms)),\n    processed_utc = EventProcessedUtcTime,\n    reason = case(\n        isempty(tenant_id) or isempty(source_instance), \"missing_identity\",\n        source_table !in (\"Projects\", \"Equipment\", \"WorkOrders\", \"JobCosts\", \"Invoices\", \"DemoHeartbeat\"), \"unknown_table\",\n        \"unexpected_fields\"\n    ),\n    unexpected_fields,\n    payload",
        "IsTransactional": false,
        "PropagateIngestionProperties": true
    }
]```

.create-or-alter materialized-view gold_projects_latest on table silver_projects
{
    silver_projects
    | summarize arg_max(processed_utc, *) by tenant_id, ProjectId
}

.create-or-alter materialized-view gold_equipment_latest on table silver_equipment
{
    silver_equipment
    | summarize arg_max(processed_utc, *) by tenant_id, EquipmentId
}

.create-or-alter materialized-view gold_work_orders_latest on table silver_work_orders
{
    silver_work_orders
    | summarize arg_max(processed_utc, *) by tenant_id, WorkOrderId
}

.create-or-alter materialized-view gold_job_costs_latest on table silver_job_costs
{
    silver_job_costs
    | summarize arg_max(processed_utc, *) by tenant_id, JobCostId
}

.create-or-alter materialized-view gold_invoices_latest on table silver_invoices
